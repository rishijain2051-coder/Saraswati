// Saraswati Export ERP — Prisma schema (Phase 1: Product Management)
// Provider is SQLite for local use. To scale later, change provider to
// "postgresql" and the DATABASE_URL — the models below are portable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & access
// ---------------------------------------------------------------------------

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("Operator") // Admin | Manager | Operator | Viewer
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  productsCreated Product[] @relation("ProductCreatedBy")
}

// ---------------------------------------------------------------------------
// Master data
// ---------------------------------------------------------------------------

model Currency {
  id         Int      @id @default(autoincrement())
  code       String   @unique // INR, USD, EUR
  name       String
  symbol     String   @default("")
  // 1 unit of THIS currency = rateToBase units of the base currency (INR).
  rateToBase Float    @default(1)
  isBase     Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  costSheets CostSheet[]
  orders     Order[]
  proformas  Proforma[]
}

model Unit {
  id        Int     @id @default(autoincrement())
  code      String  @unique // PCS, SET, KGS, CFT, SQFT, SQM, MTR, LTR
  name      String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  products Product[]
}

/// Generic managed list powering product classification + filters.
/// `type` groups values: PRODUCT_TYPE | SIZE | COLOUR | MATERIAL | FINISH | ITEM_TYPE
model AttributeValue {
  id        Int      @id @default(autoincrement())
  type      String
  value     String
  code      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  productsItemType Product[] @relation("ProductItemType")
  productsType     Product[] @relation("ProductType")
  productsSize     Product[] @relation("ProductSize")
  productsColour   Product[] @relation("ProductColour")
  productsMaterial Product[] @relation("ProductMaterial")
  productsFinish   Product[] @relation("ProductFinish")

  @@unique([type, value])
}

model Buyer {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  country     String?
  contactName String?
  email       String?
  phone       String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products  ProductBuyer[]
  orders    Order[]
  proformas Proforma[]
  ledger    LedgerEntry[]  @relation("BuyerLedger")
}

// ---------------------------------------------------------------------------
// Product
// ---------------------------------------------------------------------------

model Product {
  id          Int     @id @default(autoincrement())
  factoryCode String  @unique
  name        String // item description / name
  alias       String?
  status      String  @default("Draft") // Draft | Active | Discontinued
  description String?
  notes       String?

  // classification (master-list relations)
  itemTypeId    Int?
  productTypeId Int?
  sizeId        Int?
  colourId      Int?
  materialId    Int?
  finishId      Int?
  unitId        Int?

  // production routing — which stage line this product travels through
  stageLineId Int?

  // physical — assembled product (inches)
  prodLengthIn  Float?
  prodWidthIn   Float?
  prodHeightIn  Float?
  netWeightKg   Float?
  grossWeightKg Float?

  // physical — packed / carton (inches)
  packLengthIn    Float?
  packWidthIn     Float?
  packHeightIn    Float?
  piecesPerCarton Int?

  // differentiated volumes (CBM) — before vs after packing
  volumeBeforePackingCbm Float?
  volumeAfterPackingCbm  Float?

  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  itemType    AttributeValue? @relation("ProductItemType", fields: [itemTypeId], references: [id])
  productType AttributeValue? @relation("ProductType", fields: [productTypeId], references: [id])
  size        AttributeValue? @relation("ProductSize", fields: [sizeId], references: [id])
  colour      AttributeValue? @relation("ProductColour", fields: [colourId], references: [id])
  material    AttributeValue? @relation("ProductMaterial", fields: [materialId], references: [id])
  finish      AttributeValue? @relation("ProductFinish", fields: [finishId], references: [id])
  unit        Unit?           @relation(fields: [unitId], references: [id])
  stageLine   StageLine?      @relation(fields: [stageLineId], references: [id])
  createdBy   User?           @relation("ProductCreatedBy", fields: [createdById], references: [id])

  buyers      ProductBuyer[]
  costSheets  CostSheet[]
  images      ProductImage[]
  relatedFrom RelatedProduct[] @relation("RelatedFrom")
  relatedTo   RelatedProduct[] @relation("RelatedTo")

  orderLines      OrderLine[]
  proformaLines   ProformaLine[]
  operationSheets OperationSheet[]

  @@index([productTypeId])
  @@index([status])
}

model ProductBuyer {
  id        Int     @id @default(autoincrement())
  productId Int
  buyerId   Int
  buyerCode String? // buyer's own article/style code for THIS product

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer   Buyer   @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@unique([productId, buyerId])
}

model RelatedProduct {
  id        Int     @id @default(autoincrement())
  productId Int
  relatedId Int
  relation  String // VARIANT | PART | ACCESSORY | SET
  note      String?

  product Product @relation("RelatedFrom", fields: [productId], references: [id], onDelete: Cascade)
  related Product @relation("RelatedTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedId, relation])
}

model ProductImage {
  id           Int      @id @default(autoincrement())
  productId    Int
  filename     String
  originalName String?
  url          String
  isPrimary    Boolean  @default(false)
  caption      String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  proformaLines ProformaLine[] @relation("ProformaLineImage")
}

// ---------------------------------------------------------------------------
// Costing engine
//   CostSheet -> CostGroup (material group, defines measurement method)
//             -> CostLine  (individual part / item)
// Measures (CFT/SQFT/...) and amounts are COMPUTED by the API, not stored,
// to avoid drift.
// ---------------------------------------------------------------------------

model CostSheet {
  id                Int      @id @default(autoincrement())
  productId         Int
  version           Int      @default(1)
  name              String?  @default("Costing")
  isActive          Boolean  @default(true)
  currencyId        Int?
  factoryExpensePct Float    @default(15)
  marginPct         Float    @default(15)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product  Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  currency Currency?   @relation(fields: [currencyId], references: [id])
  groups   CostGroup[]

  @@unique([productId, version])
}

/// A costing measurement method with a user-editable formula.
/// Variables available to `expression`: L, W, H (costing dims), AL, AW, AH
/// (actual dims), QTY, WASTAGE, WEIGHT. Measure = expression; amount = measure × rate.
model CostMethod {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  label       String
  measureUnit String   @default("UNIT")
  expression  String   @default("QTY")
  usesL       Boolean  @default(false)
  usesW       Boolean  @default(false)
  usesH       Boolean  @default(false)
  usesWeight  Boolean  @default(false)
  usesWastage Boolean  @default(true)
  dimUnit     String? // IN | CM
  isBuiltIn   Boolean  @default(false)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CostGroup {
  id          Int     @id @default(autoincrement())
  costSheetId Int
  head        String // MAIN_COMPONENT | SUB_COMPONENT | HARDWARE | POLISHING | PACKAGING | LABOUR | FORWARDING
  name        String // e.g. "Mango Wood", "Iron", "Ply 6mm"
  method      String // CFT | SQFT | SQMT | WEIGHT | QTY | RFT
  dimUnit     String? // input dim unit hint for area/volume methods: IN | CM
  sortOrder   Int     @default(0)
  notes       String?

  costSheet CostSheet  @relation(fields: [costSheetId], references: [id], onDelete: Cascade)
  lines     CostLine[]
}

model CostLine {
  id         Int    @id @default(autoincrement())
  groupId    Int
  name       String
  qty        Float  @default(1)
  wastagePct Float  @default(0)

  // actual dimensions (as measured)
  actualL Float?
  actualW Float?
  actualH Float?

  // costing dimensions (drive the measure; auto-suggested from actual+wastage, editable)
  costL Float?
  costW Float?
  costH Float?

  // weight method
  actualWeight Float?

  unit      String? // display unit for this line
  rate      Float   @default(0) // cost per measure unit (per CFT / SQFT / kg / piece ...)
  sortOrder Int     @default(0)

  group CostGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Operations module (Phase 2) — proformas, orders, the production board,
// challans, suppliers, stock, material sheets, payments.
// ---------------------------------------------------------------------------

model Supplier {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  type         String   @default("MATERIAL") // MATERIAL | JOBWORK | BOTH
  contactName  String?
  email        String?
  phone        String?
  gstNo        String?
  address      String?
  paymentTerms String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockTxns  StockTxn[]
  lineStages OrderLineStage[] @relation("StageVendor")
  ledger     LedgerEntry[]    @relation("SupplierLedger")
}

model RawItem {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  category     String?
  unit         String   @default("PCS")
  reorderLevel Float    @default(0)
  openingQty   Float    @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  txns StockTxn[]
}

model StockTxn {
  id          Int      @id @default(autoincrement())
  rawItemId   Int
  type        String // IN | OUT
  qty         Float
  rate        Float    @default(0) // cost per unit (IN valuation)
  supplierId  Int?
  orderRef    String? // optional reference to an order number (for OUT)
  note        String?
  date        DateTime @default(now())
  createdById Int?
  createdAt   DateTime @default(now())

  rawItem  RawItem      @relation(fields: [rawItemId], references: [id], onDelete: Cascade)
  supplier Supplier?    @relation(fields: [supplierId], references: [id])
  /// The bill raised for this receipt, if one has been. Lets a supplier statement
  /// show which deliveries are still un-billed without ever double-counting them.
  bill     LedgerEntry?
}

// ---------------------------------------------------------------------------
// Production routing
// ---------------------------------------------------------------------------

/// A named production route ("stage line"), e.g.
///   X — raw joining → raw sanding → polishing → accessory fitting → QC → packaging
///   Y — raw joining → powder coating → fitting → QC → packing
/// A product is assigned one stage line. Each order line SNAPSHOTS the steps into
/// OrderLineStage rows, so editing the master later never rewrites live orders.
model StageLine {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps      StageLineStep[]
  products   Product[]
  orderLines OrderLine[]
}

model StageLineStep {
  id          Int    @id @default(autoincrement())
  stageLineId Int
  name        String
  sortOrder   Int    @default(0)

  stageLine StageLine @relation(fields: [stageLineId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Orders + the production board
// ---------------------------------------------------------------------------

model Order {
  id           Int       @id @default(autoincrement())
  number       String    @unique
  buyerId      Int
  currencyId   Int?
  status       String    @default("Confirmed") // Confirmed|Production|Ready|Shipped|Closed|Cancelled
  orderDate    DateTime  @default(now())
  deliveryDate DateTime?
  incoterms    String?
  exchangeRate Float? // buyer currency rateToBase snapshot
  notes        String?
  proformaId   Int?      @unique
  createdById  Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  buyer    Buyer            @relation(fields: [buyerId], references: [id])
  currency Currency?        @relation(fields: [currencyId], references: [id])
  proforma Proforma?        @relation("ProformaOrder", fields: [proformaId], references: [id])
  lines    OrderLine[]
  sheets   OperationSheet[]
  ledger   LedgerEntry[]
}

model OrderLine {
  id        Int   @id @default(autoincrement())
  orderId   Int
  productId Int
  qty       Int   @default(1)
  unitPrice Float @default(0) // in order currency
  sortOrder Int   @default(0)

  /// Which route this line follows. WHO does each stage lives on the stage rows,
  /// so any mix is possible — e.g. 1-3 in-house, 4 outsourced, 5-6 in-house.
  stageLineId Int?

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id])
  stageLine StageLine? @relation(fields: [stageLineId], references: [id])

  stages OrderLineStage[]
  moves  StageMove[]
  sheet  OperationSheet?
}

/// One stage of one order line — the snapshot of a StageLineStep.
model OrderLineStage {
  id          Int     @id @default(autoincrement())
  orderLineId Int
  name        String
  sortOrder   Int     @default(0)
  vendorId    Int? // null = in-house
  jobworkRate Float   @default(0) // ₹ per piece payable to the vendor for this stage
  note        String?

  orderLine OrderLine   @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  vendor    Supplier?   @relation("StageVendor", fields: [vendorId], references: [id])
  movesFrom StageMove[] @relation("MoveFrom")
  movesTo   StageMove[] @relation("MoveTo")

  @@unique([orderLineId, sortOrder])
}

/// Append-only ledger of piece movements. How many pieces sit where is always
/// DERIVED from these rows (see lib/production.ts) and never stored, so the board
/// can never drift out of sync with its own history.
///
///   RELEASE  : PENDING   -> toStage
///   ADVANCE  : fromStage -> toStage           (forward)
///   REJECT   : fromStage -> toStage / PENDING (backward — rework)
///   COMPLETE : fromStage -> DONE
///   RETURN   : DONE      -> toStage           (undo a completion)
model StageMove {
  id          Int      @id @default(autoincrement())
  orderLineId Int
  kind        String
  fromStageId Int?
  toStageId   Int?
  qty         Int
  date        DateTime @default(now())
  /// Free-text hand-over comment written when the pieces were passed on.
  note        String?
  createdById Int?
  createdAt   DateTime @default(now())

  orderLine OrderLine        @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  fromStage OrderLineStage?  @relation("MoveFrom", fields: [fromStageId], references: [id])
  toStage   OrderLineStage?  @relation("MoveTo", fields: [toStageId], references: [id])
  photos    StageMovePhoto[]

  @@index([orderLineId])
}

/// Photos attached to a hand-over — proof of condition when pieces change hands.
model StageMovePhoto {
  id           Int      @id @default(autoincrement())
  moveId       Int
  filename     String
  originalName String?
  url          String
  caption      String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  move StageMove @relation(fields: [moveId], references: [id], onDelete: Cascade)

  @@index([moveId])
}

model Proforma {
  id            Int       @id @default(autoincrement())
  number        String    @unique
  buyerId       Int
  currencyId    Int?
  status        String    @default("Draft") // Draft|Sent|Accepted|Rejected
  date          DateTime  @default(now())
  validUntil    DateTime?
  paymentTerms  String?
  deliveryTerms String?
  incoterms     String?
  bankDetails   String?
  notes         String?
  exchangeRate  Float?
  showImages    Boolean   @default(true) // print product photos on the PI
  sentAt        DateTime?
  decidedAt     DateTime? // when it was accepted or rejected
  rejectReason  String?
  createdById   Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  buyer    Buyer          @relation(fields: [buyerId], references: [id])
  currency Currency?      @relation(fields: [currencyId], references: [id])
  lines    ProformaLine[]
  order    Order?         @relation("ProformaOrder")
}

model ProformaLine {
  id          Int    @id @default(autoincrement())
  proformaId  Int
  productId   Int?
  imageId     Int? // which product photo to print (null = the product's primary)
  description String
  qty         Int    @default(1)
  unitPrice   Float  @default(0)
  sortOrder   Int    @default(0)

  proforma Proforma      @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  product  Product?      @relation(fields: [productId], references: [id])
  image    ProductImage? @relation("ProformaLineImage", fields: [imageId], references: [id])
}

/// "Material sheet" — a numbered printout of the live costing explosion for a
/// product × qty (what to buy / issue to the floor). Production PROGRESS lives on
/// the order board (OrderLineStage + StageMove), never here.
model OperationSheet {
  id          Int      @id @default(autoincrement())
  number      String   @unique
  productId   Int
  orderId     Int?
  orderLineId Int?     @unique
  qty         Int      @default(1)
  notes       String?
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product   Product    @relation(fields: [productId], references: [id])
  order     Order?     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderLine OrderLine? @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
}

/// Money that actually moved, plus manually-entered bills.
///
/// What is OWED is never entered by hand where the system already knows it:
///   - buyer receivable  = order value            - BUYER receipts
///   - jobwork payable   = board-accrued jobwork  - JOBWORK payments
/// So BUYER and JOBWORK rows are PAYMENT rows only; SUPPLIER (material) and WORKER
/// rows may be BILL or PAYMENT because nothing else knows those amounts.
model LedgerEntry {
  id          Int      @id @default(autoincrement())
  partyType   String // SUPPLIER | JOBWORK | BUYER | WORKER
  supplierId  Int?
  buyerId     Int?
  /// The order this money is aimed at. Optional: a payment with no order — or one
  /// larger than that order's balance — is spread oldest-first across whatever the
  /// party still owes or is owed (see lib/finance.ts). Allocation is computed on
  /// read, never stored, so it cannot go stale when values change.
  orderId     Int?
  stockTxnId  Int?     @unique // set when this bill covers a specific stock receipt
  partyName   String // snapshot / for WORKER
  kind        String // BILL | PAYMENT
  amount      Float
  currency    String?  @default("INR")
  date        DateTime @default(now())
  ref         String?
  note        String?
  createdById Int?
  createdAt   DateTime @default(now())

  supplier Supplier? @relation("SupplierLedger", fields: [supplierId], references: [id])
  buyer    Buyer?    @relation("BuyerLedger", fields: [buyerId], references: [id])
  order    Order?    @relation(fields: [orderId], references: [id])
  stockTxn StockTxn? @relation(fields: [stockTxnId], references: [id])

  @@index([orderId])
  @@index([partyType, supplierId])
  @@index([partyType, buyerId])
}

model DocSequence {
  id      Int     @id @default(autoincrement())
  key     String  @unique // PI | ORD | OP
  prefix  String
  useYear Boolean @default(false)
  lastNo  Int     @default(0)
}
